# Configuración del entorno de desarrollo de AFINIA Backend
FLASK_ENV=development
ENVIRONMENT=development
PORT=5000

# Clave secreta para JWT, cookies y firmas HMAC (mínimo 32 caracteres)
SECRET_KEY=c00fc34e5b7d4f11562ebd2a0cd30aa49e04967818d79197577f7899c47bdf46

# Conexión a PostgreSQL (ajustar host, puerto, usuario y contraseña según entorno local)
# Si usas docker-compose: postgresql://afinia_user:afinia_password@localhost:5432/afinia_db
# Si usas el contenedor QA: postgresql://afinia_qa_user:afinia_qa_pass@127.0.0.1:55433/afinia_qa_db
DATABASE_URL=postgresql://afinia_user:afinia_password@localhost:5432/afinia_db

# Parámetros de Tokens y Sesión
JWT_ACCESS_TOKEN_EXPIRES=900
REFRESH_TOKEN_EXPIRES_DAYS=30
REFRESH_CONCURRENCY_WINDOW_SECONDS=15
SESSION_COOKIE_SECURE=false

# CORS (Orígenes autorizados para frontend Ionic / Angular)
CORS_ORIGINS=http://localhost:8100,http://127.0.0.1:8100,http://localhost:4200,http://127.0.0.1:4200,capacitor://localhost,ionic://localhost

# Servicio de Correo (in_memory para desarrollo/pruebas locales)
MAIL_BACKEND=in_memory
EMAIL_VERIFICATION_TOKEN_HOURS=24
RESEND_COOLDOWN_SECONDS=60
FRONTEND_URL=http://localhost:8100
